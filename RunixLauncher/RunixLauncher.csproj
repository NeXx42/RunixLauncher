<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Deps -->
  <ItemGroup>
    <ProjectReference Include="..\Runix.Logic\Runix.Logic.csproj" />
    <ProjectReference Include="..\Runix.Input\Runix.Input.csproj" />
  </ItemGroup>
  <!-- Resources -->
  <Target Name="CopyToBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <ThemeFiles Include="Themes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ThemeFiles)" DestinationFolder="$(TargetDir)Themes\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <ThemeFiles Include="Themes\**\*.*" />
      <LanguageFiles Include="Languages\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ThemeFiles)" DestinationFolder="$(PublishDir)Themes\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Overlay -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' And Exists('..\GameLibrary_GTKOverlay\target\debug\GameLibrary_GTKOverlay')">
    <None Include="..\GameLibrary_GTKOverlay\target\debug\GameLibrary_GTKOverlay">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\GameLibrary_GTKOverlay\target\release\GameLibrary_GTKOverlay">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>